# SPDX-License-Identifier: Apache-2.0
# The Glass touchpad (docs/specs/touchpad-gestures.md). glassd reads it and turns gestures into
# key events for regular apps (docs/api.md "Android glue"); for Android it is a touch navigation
# device, so no pointer is shown and no screen coordinates are produced.
touch.deviceType = touchNavigation
device.internal = 1
